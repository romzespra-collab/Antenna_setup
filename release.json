{
  "repo": "romzespra-collab/Antenna_setup",
  "programs": [
    {
      "name": "antenna_setup",
      "dir": "",
      "files": [
        ["VERSION", "{v}"],
        ["antenna_setup.pyw", "VERSION = \"{v}\""],
        ["antenna_setup.pyw", "antenna_setup.pyw  v{v}"],
        ["antenna_setup.spec", "antenna_setup.spec  v{v}"],
        ["build_exe.bat", "build_exe.bat  v{v}"],
        ["setup.bat", "setup.bat  v{v}"],
        ["README.md", "# Antenna_setup  v{v}"]
      ],
      "headers": false,
      "changelog": [
        {"file": "CHANGELOG.md", "before": "re:^### v\\d", "template": "### v{v} — {msg}\n",
         "keep": 10, "tail": "Более ранние версии"},
        {"file": "antenna_setup.pyw", "after": "Журнал изменений:", "template": "  v{v}: {msg}\n",
         "wrap": 111, "keep": 10, "entry": "re:^  v\\d+\\.\\d+\\.\\d+:", "tail": "  Более ранние версии"}
      ],
      "allow_in_zip": []
    }
  ]
}
